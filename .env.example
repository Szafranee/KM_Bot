# Telegram bot token from @BotFather
TELEGRAM_API_TOKEN=

# --- Webhook (hosting) -------------------------------------------------------------------------
# Public HTTPS URL of the webhook endpoint served by passenger_wsgi.py
WEBHOOK_URL=https://kmbot.example.pl/telegram
# Random secret checked on every webhook request, e.g. output of:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=
# Public base URL of the app - rolling stock photos are served from <PUBLIC_BASE_URL>/img/...
PUBLIC_BASE_URL=https://kmbot.example.pl

# --- Data sources ------------------------------------------------------------------------------
# Optional: PKP PLK "Otwarte Dane Kolejowe" API key (https://pdp-api.plk-sa.pl). Without it the bot
# uses the keyless mkuran.pl realtime feed for delays.
PLK_API_KEY=
# Optional: Gemini API key - fallback for date notations the PDF parser does not recognise.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Misc --------------------------------------------------------------------------------------
# Optional: comma-separated Telegram user ids allowed to use the bot (empty = everyone)
ALLOWED_USER_IDS=
# Optional: data directory (default: ./data) and log file
# DATA_DIR=
# LOG_FILE=data/km_bot.log
# LOG_LEVEL=INFO
